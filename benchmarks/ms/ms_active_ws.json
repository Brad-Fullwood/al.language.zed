[
  {
    "method": "al/setActiveWorkspace",
    "kind": "request",
    "timeout": 300,
    "params": {
      "currentWorkspaceFolderPath": {
        "uri": {
          "$mid": 1,
          "fsPath": "__ROOT_PATH__",
          "path": "__ROOT_PATH__",
          "scheme": "file"
        },
        "name": "__ROOT_NAME__",
        "index": 0
      },
      "settings": {
        "workspacePath": "__ROOT_PATH__",
        "alResourceConfigurationSettings": {
          "assemblyProbingPaths": [],
          "codeAnalyzers": [],
          "enableCodeAnalysis": false,
          "backgroundCodeAnalysis": "File",
          "packageCachePaths": ["__ALPACKAGES__"],
          "ruleSetPath": null,
          "enableCodeActions": true,
          "incrementalBuild": false,
          "outputAnalyzerStatistics": false,
          "enableExternalRulesets": false
        },
        "setActiveWorkspace": true,
        "expectedProjectReferenceDefinitions": [],
        "activeWorkspaceClosure": ["__ROOT_PATH__"]
      }
    }
  },
  {
    "method": "al/progressNotification",
    "kind": "wait_notification",
    "timeout": 300,
    "match": {
      "percent": 100
    }
  }
]
