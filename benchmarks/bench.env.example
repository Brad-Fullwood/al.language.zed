# Machine-specific paths for the benchmark harness. Copy to bench.env and edit.
#   source benchmarks/bench.env

# Installed Microsoft AL extension (VS Code or Cursor). Supplies alc and the
# EditorServices language server that we benchmark against.
export AL_MS_EXT="$HOME/.cursor/extensions/ms-dynamics-smb.al-17.0.2273547"
export ALC_PATH="$AL_MS_EXT/bin/linux/alc.dll"

# A directory of BC symbol packages (.app) to build the synthetic corpus
# against. Any project's .alpackages containing the BC 28.1 set will do.
export AL_BENCH_PACKAGES="$HOME/path/to/a/project/.alpackages"

# Optional: a real production solution for the real-world tier. Omit to skip.
export AL_BENCH_REAL_ROOT="$HOME/path/to/customer/solution"
export AL_BENCH_CORPUS_NAME="private production corpus"
export AL_BENCH_PROJECTS="Business Central,Integration"
