[
  {
    "label": "AL: Open Object Explorer",
    "command": "al-explorer",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["al-open-object-explorer"]
  },
  {
    "label": "AL: Download Symbols (Server)",
    "command": "al",
    "args": ["download-symbols", "--source", "server"],
    "tags": ["al-download-symbols-server"]
  },
  {
    "label": "AL: Download Symbols (NuGet)",
    "command": "al",
    "args": ["download-symbols", "--source", "nuget"],
    "tags": ["al-download-symbols-nuget"]
  },
  {
    "label": "AL: Lint All",
    "command": "al",
    "args": ["lint", "--all"],
    "tags": ["al-lint-all"]
  },
  {
    "label": "AL: Format All",
    "command": "al",
    "args": ["format", "--all"],
    "tags": ["al-format-all"]
  },
  {
    "label": "AL: Clear Symbol Cache",
    "command": "al",
    "args": ["clear-cache"],
    "tags": ["al-clear-cache"]
  }
]
