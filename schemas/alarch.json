{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AL Architecture Rules",
    "description": "Schema for .alarch.json rules consumed by al-explorer arch-lint and native workspace diagnostics.",
    "type": "object",
    "properties": {
        "rules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "description", "kind"],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "namingConvention",
                            "forbiddenPattern",
                            "requiredProperty",
                            "maxComplexity"
                        ]
                    },
                    "pattern": {
                        "type": "string",
                        "description": "Optional case-insensitive exact AL object-kind scope, for example table or codeunit. Empty applies to every object kind.",
                        "default": ""
                    },
                    "values": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "default": []
                    },
                    "regex": {
                        "type": "boolean",
                        "description": "For forbiddenPattern only, interpret values as Rust regular expressions instead of case-insensitive literals. NamingConvention values are always regular expressions.",
                        "default": false
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "kind": {
                                    "const": "namingConvention"
                                }
                            }
                        },
                        "then": {
                            "required": ["values"],
                            "properties": {
                                "values": {
                                    "minItems": 1,
                                    "maxItems": 1
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "kind": {
                                    "const": "forbiddenPattern"
                                }
                            }
                        },
                        "then": {
                            "required": ["values"],
                            "properties": {
                                "values": {
                                    "minItems": 1
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "kind": {
                                    "enum": ["requiredProperty", "maxComplexity"]
                                }
                            }
                        },
                        "then": {
                            "required": ["values"],
                            "properties": {
                                "values": {
                                    "minItems": 1,
                                    "maxItems": 1
                                },
                                "regex": {
                                    "const": false
                                }
                            }
                        }
                    }
                ],
                "additionalProperties": false
            },
            "default": []
        }
    },
    "additionalProperties": false
}
