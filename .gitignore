# Build outputs
/target
*.wasm
*.rlib
/grammars/
.alpackages/

# .NET build artifacts (scope to dotnet/ and bridge/ subdirs so Rust
# `src/bin/` directories aren't accidentally ignored)
crates/*/dotnet/**/obj/
crates/*/dotnet/**/bin/
crates/*/bridge/obj/
crates/*/bridge/bin/

# Claude Code automation state (local) — but track shared skills
.claude/*
!.claude/skills/
!.claude/skills/**
.agentic/
.mcp.json

# Supervisor / runtime state
/tmp/al-*

# Environment / secrets
.env
.env.*
*.env

# cargo-mutants output
/mutants.out/
/mutants.out.old/

# AL build artifacts (compiled .app packages)
*.app
!crates/al-lsp/benches/fixtures/representative.app
