# Build outputs
/target
*.wasm
*.rlib
/grammars/
.alpackages/

# .NET build artifacts (scope to dotnet/ and bridge/ subdirs so Rust
# `src/bin/` directories aren't accidentally ignored)
crates/*/dotnet/**/obj/
crates/*/dotnet/**/bin/
crates/*/bridge/obj/
crates/*/bridge/bin/

# Claude Code automation state (local)
.claude/
.agentic/
.mcp.json

# Supervisor / runtime state
/tmp/al-*

# Environment / secrets
.env
.env.*
*.env
