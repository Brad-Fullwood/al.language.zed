[
  {
    "label": "Extension: cargo check (native crates)",
    "command": "cargo",
    "args": ["check", "--workspace", "--exclude", "zed-al"],
    "reveal": "always"
  },
  {
    "label": "Extension: cargo test (native crates)",
    "command": "cargo",
    "args": ["test", "--workspace", "--exclude", "zed-al"],
    "reveal": "always"
  },
  {
    "label": "Extension: clippy -D warnings",
    "command": "cargo",
    "args": ["clippy", "--workspace", "--exclude", "zed-al", "--", "-D", "warnings"],
    "reveal": "always"
  },
  {
    "label": "Extension: make install (build + symlink + Zed dev install)",
    "command": "make",
    "args": ["install"],
    "reveal": "always"
  },
  {
    "label": "Extension: real-project validation gate",
    "command": "scripts/validate-real-projects.sh",
    "reveal": "always"
  },
  {
    "label": "Extension: build WASM (zed-al)",
    "command": "cargo",
    "args": ["build", "-p", "zed-al", "--target", "wasm32-wasip1", "--release"],
    "reveal": "always"
  }
]
