[
  {
    "label": "Extension: cargo check (native crates)",
    "command": "cargo",
    "args": ["check", "--workspace", "--exclude", "zed-al"],
    "reveal": "always"
  },
  {
    "label": "Extension: cargo test (native crates)",
    "command": "cargo",
    "args": ["test", "--workspace", "--exclude", "zed-al"],
    "reveal": "always"
  },
  {
    "label": "Extension: clippy -D warnings",
    "command": "cargo",
    "args": ["clippy", "--workspace", "--exclude", "zed-al", "--", "-D", "warnings"],
    "reveal": "always"
  },
  {
    "label": "Extension: make install (build + symlink + Zed dev install)",
    "command": "make",
    "args": ["install"],
    "reveal": "always"
  },
  {
    "label": "Extension: build WASM (zed-al)",
    "command": "cargo",
    "args": ["build", "-p", "zed-al", "--target", "wasm32-wasip2", "--release"],
    "reveal": "always"
  },
  {
    "label": "AL: Affected tests (current file)",
    "command": "al-explorer",
    "args": ["test-affected", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: Apply safe quick fixes (current file)",
    "command": "al-explorer",
    "args": ["fix", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: Dependency graph (JSON)",
    "command": "al-explorer",
    "args": ["deps-graph", "--format", "json"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: XLIFF generate base",
    "command": "al-explorer",
    "args": ["xlf", "generate", "--project", "$ZED_WORKTREE_ROOT"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: XLIFF refresh language file (current .xlf)",
    "command": "al-explorer",
    "args": ["xlf", "refresh", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: XLIFF list untranslated (current .xlf)",
    "command": "al-explorer",
    "args": ["xlf", "untranslated", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: XLIFF suggest translations (current .xlf)",
    "command": "al-explorer",
    "args": ["xlf", "suggest", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: Test snapshot diff (baseline vs current)",
    "command": "al-explorer",
    "args": ["test-snapshot", "diff", "$ZED_WORKTREE_ROOT/test-snapshots/baseline.snap.json", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: Validate test snapshot (current .snap.json)",
    "command": "al-explorer",
    "args": ["test-snapshot", "validate", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: Replay test snapshot on live BC (current .snap.json)",
    "command": "al-explorer",
    "args": ["test-snapshot", "replay", "$ZED_FILE", "--bc-version", "$AL_BC_VERSION"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "AL: Table impact (symbol under cursor)",
    "command": "al-explorer",
    "args": ["impact", "$ZED_SYMBOL", "--table"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
