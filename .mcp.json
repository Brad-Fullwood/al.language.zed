{
  "mcpServers": {
    "rust-analyzer": {
      "command": "rust-analyzer-mcp",
      "env": {
        "RUST_LOG": "warn"
      }
    },
    "docs-rs": {
      "command": "npx",
      "args": ["-y", "@nuskey8/docs-rs-mcp@latest"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
