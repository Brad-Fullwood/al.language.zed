// AL for Zed: example configuration.
//
// Copy the blocks you want into your Zed settings.json ("zed: open settings"
// from the command palette) or a project-local .zed/settings.json. Comments
// (JSONC) are for guidance only. Zed's settings.json accepts them, but strip
// them if you paste into strict JSON.
{
  "lsp": {
    // ─────────────────────────────────────────────────────────────────────
    // AL Language Server (al-lsp).
    //
    // Every setting the server understands is listed below with its DEFAULT
    // value. Delete the ones you don't need to change. In v0.5.0 no key
    // autocompletes or validates as you type: the extension builds against
    // Zed extension API 0.7.0. The settings still apply. See
    // Docs/reference/settings.md for the full reference.
    // ─────────────────────────────────────────────────────────────────────
    "al-lsp": {
      // The extension ignores "binary". For a local build, run `make install`,
      // which writes dev/al-lsp in the extension's work directory. The extension
      // uses that copy first.

      "settings": {
        // ── Semantic analysis ──
        "al.enableCodeAnalysis": true,
        "al.backgroundCodeAnalysis": true,
        "al.diagnosticsScope": "project", // "project" | "openFiles"
        "al.diagnosticsTrigger": "continuous", // "continuous" | "onSave"
        "al.codeAnalyzers": ["CodeCop", "AppSourceCop", "UICop", "PerTenantCop"],
        "al.enableExternalRulesets": false,
        "al.ruleSetPath": null, // e.g. "./custom.ruleset.json"
        "al.assemblyProbingPaths": [],
        "al.outputAnalyzerStatistics": false,

        // ── Editor features ──
        "al.enableCodeActions": true,
        "al.inlayHints.parameterNames": true,
        "al.inlayHints.returnTypes": false,

        // ── Formatting ──
        "al.formatting.blankLinesBetweenProcedures": "preserve", // "preserve" | "one" | "two"
        "al.formatting.maxLineLength": 0, // 0 disables wrapping
        "al.formatting.braceStyle": "nextLine", // "sameLine" | "nextLine"
        "al.formatting.sortProperties": false,

        // ── Native lint ──
        "al.enableNativeLint": true,
        "al.nativeLintRules": {},

        // ── Symbols / packages ──
        "al.packageCachePath": null, // default: <project>/.alpackages/
        "al.appLocalFolderPaths": [],
        "al.nugetFeeds": [], // [{ "name": "MyFeed", "url": "https://…/index.json" }]
        "al.useOnlyCustomFeeds": false,
        "al.symbolsCountryRegion": null, // e.g. "us", "gb", "au"

        // ── Compiler ──
        "al.compilationOptions": [],
        "al.incrementalBuild": false,
        "al.useOfficialCompiler": null,

        // ── Resource limits ──
        "al.maxDocumentSizeBytes": null, // null = no cap
        "al.indexThreads": null, // null = half the cores, between 2 and 4

        // ── Toolchain ──
        // Path to the dotnet host used for Microsoft ALTool, alc, the semantic
        // bridge, and the official LSP/DAP escape hatches. Exported to al-lsp
        // as AL_DOTNET_PATH when it names a program outside the project. A
        // relative path, or one inside the project, is dropped. null = resolve
        // `dotnet` from PATH.
        "al.dotnetPath": null,

        // ── Escape hatches ──
        "al.useOfficialLsp": false, // true delegates to Microsoft's official AL LSP (needs ALTool v17+)
        "al.useOfficialDap": false // true uses Microsoft EditorServices.Host for debugging
      }
    },

    // ─────────────────────────────────────────────────────────────────────
    // Autocomplete + validation for AL project files (app.json, rulesets, …).
    //
    // Zed's bundled JSON language server validates files against schemas you
    // associate by fileMatch. This works on ALL Zed channels. The URLs are
    // pinned to the v0.5.0 release tag for reproducible validation. The tag
    // must equal the extension version in extension.toml, so bump it when you
    // upgrade the extension.
    // ─────────────────────────────────────────────────────────────────────
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": ["app.json"],
              "url": "https://raw.githubusercontent.com/Brad-Fullwood/al.language.zed/v0.5.0/schemas/app.json"
            },
            {
              "fileMatch": ["*.ruleset.json"],
              "url": "https://raw.githubusercontent.com/Brad-Fullwood/al.language.zed/v0.5.0/schemas/ruleset.json"
            },
            {
              "fileMatch": [".alarch.json"],
              "url": "https://raw.githubusercontent.com/Brad-Fullwood/al.language.zed/v0.5.0/schemas/alarch.json"
            },
            {
              "fileMatch": ["AppSourceCop.json"],
              "url": "https://raw.githubusercontent.com/Brad-Fullwood/al.language.zed/v0.5.0/schemas/appsourcecop.json"
            },
            {
              "fileMatch": ["migration.json", "*.migration.json"],
              "url": "https://raw.githubusercontent.com/Brad-Fullwood/al.language.zed/v0.5.0/schemas/migration.json"
            }
          ]
        }
      }
    }
  }
}
