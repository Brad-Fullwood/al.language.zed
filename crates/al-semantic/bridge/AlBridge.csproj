<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!--
      Run on the newest installed .NET runtime. The bridge targets net8.0, but
      the AL 18 toolchain also ships a net10.0 build, and the ALCops analyzers
      bundled with the AL 18 VS Code extension reference .NET 10 only. On .NET 8
      they cannot load. `LatestMajor` also covers a machine with only a newer
      runtime than 8. Bridge.cs then picks the toolchain build for this runtime.
    -->
    <RollForward>LatestMajor</RollForward>
    <RollForwardToPreReleaseVersions>true</RollForwardToPreReleaseVersions>
  </PropertyGroup>
</Project>
