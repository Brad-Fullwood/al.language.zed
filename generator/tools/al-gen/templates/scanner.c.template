    uint8_t bits = 0;
    if (scanner->if_stack[i].parent_active) bits |= 0x01;
    if (scanner->if_stack[i].branch_taken)  bits |= 0x02;
    if (scanner->if_stack[i].this_active)   bits |= 0x04;
